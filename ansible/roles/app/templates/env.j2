# Managed by Ansible — do not edit manually
# Template: roles/app/templates/env.j2
# This file contains secrets — permissions set to 0600

# ── Spring Boot profile ───────────────────────────────────────
SPRING_PROFILES_ACTIVE={{ env }}

# ── Database (AWS RDS) ────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://{{ vault_db_host }}:{{ db_port }}/{{ db_name }}
SPRING_DATASOURCE_USERNAME={{ vault_db_user }}
SPRING_DATASOURCE_PASSWORD={{ vault_db_password }}

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET={{ vault_jwt_secret }}
JWT_EXPIRATION=3600000

# ── AWS S3 ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID={{ vault_aws_access_key }}
AWS_SECRET_ACCESS_KEY={{ vault_aws_secret_key }}
AWS_S3_BUCKET={{ vault_s3_bucket }}
AWS_REGION=us-east-1

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL={{ log_level }}

# ── App metadata ─────────────────────────────────────────────
APP_ENV={{ env }}
APP_NAME={{ app_name }}
