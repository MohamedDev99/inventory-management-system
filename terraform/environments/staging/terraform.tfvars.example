##############################################################################
# environments/staging/terraform.tfvars.example
#
# Values for the STAGING workspace.
#
# HOW TO USE:
#   terraform workspace select staging
#   terraform apply -var-file="environments/staging/terraform.tfvars"
#
# PHILOSOPHY: Staging mirrors prod as closely as possible without the cost.
#   - Same instance types, but smaller
#   - Same Multi-AZ decision as prod (false here, but test prod config first)
#   - 7-day backup retention
#   - No deletion protection (allow teardown for cost savings when not in use)
##############################################################################

aws_region    = "us-east-1"
owner_email   = "devops@moeware.com"

# Networking
vpc_cidr           = "10.1.0.0/16"  # Different CIDR from dev to allow VPC peering later
availability_zones = ["us-east-1a", "us-east-1b"]
enable_nat_gateway = true
single_nat_gateway = true

# Compute
instance_type         = "t3.small"
min_instances         = 1
desired_instances     = 2
max_instances         = 3
enable_spot_instances = true  # Still OK for staging

# Database
db_instance_class        = "db.t3.small"
db_name                  = "inventory_db"
db_username              = "ims_admin"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_multi_az              = false
db_backup_retention_days = 7
db_deletion_protection   = false

# Storage
s3_bucket_name_prefix = "moeware-ims"
enable_s3_versioning  = true

# Application — set to specific tags for staging (not "latest")
backend_image_tag  = "latest"
frontend_image_tag = "latest"
