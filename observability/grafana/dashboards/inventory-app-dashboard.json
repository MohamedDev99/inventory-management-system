{
  "title": "Inventory App — Golden Signals",
  "uid": "inventory-golden-signals",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"inventory-backend\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"inventory-backend\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"inventory-backend\"}[5m]))",
          "legendFormat": "5xx error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"inventory-backend\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"inventory-backend\"}[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"inventory-backend\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "CPU vs Memory (Saturation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"inventory-app\"}[5m])) by (pod)", "legendFormat": "{{pod}} CPU cores" },
        { "expr": "sum(container_memory_working_set_bytes{namespace=\"inventory-app\"}) by (pod)", "legendFormat": "{{pod}} memory bytes" }
      ]
    },
    {
      "id": 5,
      "title": "HikariCP Pool Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"inventory-backend\"} / hikaricp_connections_max{application=\"inventory-backend\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "max": 1, "min": 0,
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Low Stock Products",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "inventory_low_stock_products_total" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 10 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Orders per Hour (created vs cancelled)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(inventory_orders_created_total[1h])) * 3600", "legendFormat": "created" },
        { "expr": "sum(rate(inventory_orders_cancelled_total[1h])) * 3600", "legendFormat": "cancelled" }
      ]
    }
  ]
}
