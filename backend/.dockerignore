# =============================================================================

# .dockerignore — Spring Boot Backend (Maven)

# =============================================================================

# Works exactly like .gitignore but for the Docker build context.

# Docker sends everything in the build context to the Docker daemon before

# building. Ignoring unnecessary files means:

# - Faster builds (less data to transfer)

# - Smaller image layers

# - No accidental leaking of secrets or IDE configs into the image

# =============================================================================

# -----------------------------------------------------------------------------

# Maven build output

# These are generated by "mvn package" on your machine. Inside the Docker

# build, the builder stage runs its OWN "mvn package" inside the container,

# so your local /target folder is never needed — sending it wastes bandwidth

# and risks shipping stale/wrong JARs.

# -----------------------------------------------------------------------------

target/ !target/\*.jar

# -----------------------------------------------------------------------------

# Maven wrapper (optional)

# If you use ./mvnw instead of mvn, keep these. If you use the system mvn

# inside the Docker image, ignore them to reduce context size.

# Uncomment the block below to ignore the wrapper:

# .mvn/

# mvnw

# mvnw.cmd

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------

# IDE and editor files

# These are developer-machine-only config files. They have no effect inside

# a container and just bloat the build context.

# -----------------------------------------------------------------------------

# IntelliJ IDEA

.idea/ _.iml _.iws \*.ipr out/

# Eclipse / STS

.eclipse/ .settings/ .classpath .project .springBeans \*.launch

# VS Code

.vscode/

# NetBeans

nbactions.xml nb-configuration.xml

# Generic editor backup files

_.swp _.swo _~ _.bak

# -----------------------------------------------------------------------------

# OS-generated files

# macOS and Windows create hidden metadata files that serve no purpose inside

# a Linux container.

# -----------------------------------------------------------------------------

# macOS

.DS*Store .DS_Store? .*\* .Spotlight-V2 .Trashes

# Windows

Thumbs.db ehthumbs.db Desktop.ini

# -----------------------------------------------------------------------------

# Git

# The .git directory contains your entire commit history — it can be hundreds

# of MB. It's completely irrelevant to running the application.

# -----------------------------------------------------------------------------

.git/ .gitignore .gitattributes

# -----------------------------------------------------------------------------

# Docker files themselves

# No need to copy Docker config into the image — it's only used at build time.

# -----------------------------------------------------------------------------

Dockerfile Dockerfile._ .dockerignore docker-compose_.yml

# -----------------------------------------------------------------------------

# Environment and secrets

# CRITICAL: Never let .env files into the image. They contain passwords, API

# keys, and JWT secrets. Pass secrets via environment variables in docker-compose

# or a secrets manager — never bake them into the image layer.

# -----------------------------------------------------------------------------

.env .env.\* \*.env !.env.example

# -----------------------------------------------------------------------------

# Logs

# Application logs are written at runtime inside the container (or to a mounted

# volume). Local log files from development have no place in the image.

# -----------------------------------------------------------------------------

logs/ \*.log log/

# -----------------------------------------------------------------------------

# Test output and reports

# Tests run in the CI pipeline, not inside the production image. These

# directories can be large (Surefire XML reports, Jacoco HTML coverage reports).

# -----------------------------------------------------------------------------

**/test-results/ **/surefire-reports/ **/failsafe-reports/ **/jacoco/ coverage/

# -----------------------------------------------------------------------------

# Documentation

# Markdown files, architecture diagrams, and API docs don't affect how the

# Spring Boot app runs. Exclude them to keep the build context clean.

# -----------------------------------------------------------------------------

_.md docs/ _.pdf _.png _.jpg _.jpeg _.gif \*.svg

# -----------------------------------------------------------------------------

# Terraform / Ansible / DevOps files

# If these live in the same repo root, make sure they don't get sent to the

# backend Docker build context unnecessarily.

# -----------------------------------------------------------------------------

terraform/ ansible/ .github/ scripts/ k8s/ helm/

# -----------------------------------------------------------------------------

# Node / Frontend (if frontend lives in same repo)

# Prevents accidentally including the entire node_modules tree if the frontend

# folder is inside the backend context.

# -----------------------------------------------------------------------------

node_modules/ frontend/
